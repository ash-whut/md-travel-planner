# Copy to .env.local (git-ignored) and adjust. Only VITE_* variables reach the browser.

# Backend API base URL (FastAPI, see docs/setup-guide.md)
VITE_API_BASE_URL=http://localhost:8000/api

# Stage 2+: Google Maps browser key (referrer-restricted) and Map ID for Advanced Markers
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=
