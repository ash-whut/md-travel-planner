# Copy to backend/.env (git-ignored) and fill in what you need. See docs/setup-guide.md §4-§6.
# With the defaults below the app runs offline: no keys needed.

# --- LLM (Stage 1) ---
# fake = canned replies, no key | openai_compat = TAMU AI or any OpenAI-compatible API | anthropic = Claude API
LLM_PROVIDER=fake
# Real-LLM example (TAMU AI, setup-guide §6.2). For anthropic use e.g. LLM_MODEL=claude-sonnet-5-5.
LLM_MODEL=protected.Claude-Opus-5
# Small/cheap model for session titles (Stage 4), e.g. claude-haiku-5-5
LLM_FAST_MODEL=
# Your own key; never commit it or paste it anywhere else.
LLM_API_KEY=
# Required for openai_compat; ignored by fake and anthropic.
LLM_BASE_URL=https://chat-api.tamu.ai/openai

# --- External tools ---
# mock = fixtures, no network | live = real APIs (Stage 2+)
TOOL_PROVIDER_MODE=mock
# Google Maps Platform server key (Stage 2+, setup-guide §6.3)
GOOGLE_MAPS_SERVER_KEY=
# SerpApi key for hotel prices (Stage 3+, optional, setup-guide §6.4)
SERPAPI_KEY=

# --- Database ---
# Default is backend/travel.db (resolved by the app). Only set this to use a different database;
# a relative path like sqlite:///./travel.db is relative to where you start uvicorn.
# DATABASE_URL=sqlite:///./travel.db
