# Backend settings. Copy to backend/.env (git-ignored) and fill in what you need.
# With the defaults below the app runs fully offline: no keys needed.
# See the README "Run modes" and "API keys" sections.

# --- LLM ---
# Which LLM provider to use: fake (offline, canned replies) or openai_compat (TAMU AI).
LLM_PROVIDER=fake
# Model id for openai_compat (a TAMU AI model id). Ignored by fake.
LLM_MODEL=protected.Claude-Opus-5
# Model id for the chat role (understand, chat replies, the post-plan summary), decisions D26.
# LLM_MODEL above runs the planner and compose. Leave empty to use LLM_MODEL for chat too.
LLM_CHAT_MODEL=protected.Claude-Sonnet-5
# Your own TAMU AI API key. Never commit it or paste it anywhere else. Ignored by fake.
LLM_API_KEY=
# OpenAI-compatible base URL, e.g. https://chat-api.tamu.ai/openai (decisions D16). Ignored by fake.
LLM_BASE_URL=https://chat-api.tamu.ai/openai

# --- External tools ---
# mock = recorded JSON from app/tools/mocks/ (offline); live = call the real services.
TOOL_PROVIDER_MODE=mock
# Geoapify API key for places and geocoding (free plan, no card). Needed only in live mode.
GEOAPIFY_KEY=
# SerpApi key for hotel prices (free plan). Optional: without it, hotels show no prices.
SERPAPI_KEY=

# --- Database ---
# Optional. Default is backend/travel.db (resolved by the app). Set only to use another database;
# a relative path like sqlite:///./travel.db is relative to where you start uvicorn.
# DATABASE_URL=sqlite:///./backend/travel.db   (when uvicorn starts from the repo root)
